root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,md}]
indent_size = 2

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets}]
charset = utf-8
